# Paste into Netlify → Site configuration → Environment variables
# (Scope: Production + Deploy previews if you test PRs)
#
# After deploy, add your Netlify URL to Belmo CORS_ORIGINS, e.g.:
#   CORS_ORIGINS=https://YOUR-SITE.netlify.app
#   PUBLIC_APP_URL=https://YOUR-SITE.netlify.app

# Backend API (Belmo) — no trailing slash
NEXT_PUBLIC_API_URL=https://vegasphere-41e7.onbelmo.uk

# WebRTC ICE — STUN + TURN (same as Belmo ICE_SERVERS). Used before /calls/ice-servers loads.
NEXT_PUBLIC_WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":["turn:openrelay.metered.ca:80","turn:openrelay.metered.ca:443","turn:openrelay.metered.ca:443?transport=tcp"],"username":"openrelayproject","credential":"openrelayproject"}]
NEXT_PUBLIC_WEBRTC_ICE_CANDIDATE_POOL_SIZE=10
# Uncomment to force all media through TURN (debug only — uses more bandwidth):
# NEXT_PUBLIC_WEBRTC_ICE_TRANSPORT_POLICY=relay

# Call quality caps
NEXT_PUBLIC_WEBRTC_MAX_VIDEO_BITRATE=1200000
NEXT_PUBLIC_WEBRTC_MAX_AUDIO_BITRATE=32000

# Web Push — must match backend VAPID_PUBLIC_KEY
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BNLj5ntnp2CTBREefvt0aNJgabNg0RJ9XWJk5YCPGyGFmzGz9vfywb52z9iSl5eqooxvf-niGNryBdWJ2R_ilKI
