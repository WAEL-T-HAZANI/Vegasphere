# Paste into Netlify → Site configuration → Environment variables
# (Scope: Production + Deploy previews if you test PRs)
#
# After deploy, add your Netlify URL to Belmo CORS_ORIGINS, e.g.:
#   CORS_ORIGINS=https://YOUR-SITE.netlify.app
#   PUBLIC_APP_URL=https://YOUR-SITE.netlify.app

# Backend API (Belmo) — no trailing slash
NEXT_PUBLIC_API_URL=https://vegasphere-41e7.onbelmo.uk

# Voice/video calls use Jitsi Meet (meet.jit.si) — no WebRTC ICE env vars needed.
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si
# Web Push — must match backend VAPID_PUBLIC_KEY
